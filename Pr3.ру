import pandas as pd
import matplotlib.pyplot as plt

# ==========================================
# Задание 1
# ==========================================
df = pd.read_csv("vgsales.csv")
print("--- Задание 1 ---")
print(df.head(10))

# ==========================================
# Задание 2
# ==========================================
print("\n--- Задание 2 ---")
print(f"Количество строк: {df.shape[0]}, столбцов: {df.shape[1]}")
print("Названия столбцов:", list(df.columns))
print("\nТипы данных:")
print(df.dtypes)
print("\nОсновные статистические характеристики:")
print(df.describe())

# Ответы на вопросы Задания 2:
# Числовые столбцы: Rank, Year, NA_Sales, EU_Sales, JP_Sales, Other_Sales, Global_Sales
# Текстовые столбцы: Name, Platform, Genre, Publisher
# Данные о продажах: NA_Sales, EU_Sales, JP_Sales, Other_Sales, Global_Sales

# ==========================================
# Задание 3
# ==========================================
print("\n--- Задание 3 ---")
null_counts = df.isnull().sum()
print("Пропуски по столбцам:")
print(null_counts)
print(f"Больше всего пропусков в столбце: {null_counts.idxmax()} ({null_counts.max()})")
print("\nСтроки с пропущенным Year:")
print(df[df["Year"].isnull()].head())

# ==========================================
# Задание 4
# ==========================================
print("\n--- Задание 4 ---")
df_clean = df.dropna(subset=["Year"]).copy()
print(f"Строк в df: {df.shape[0]}")
print(f"Строк в df_clean: {df_clean.shape[0]}")
print("Пропуски в df_clean:")
print(df_clean.isnull().sum())

# Вопрос 4: Пропуски мешают корректной группировке по годам и временному анализу.

# ==========================================
# Задание 5
# ==========================================
print("\n--- Задание 5 ---")
print("Количество жанров:", df_clean["Genre"].nunique())
print("Количество платформ:", df_clean["Platform"].nunique())
print("Количество издателей:", df_clean["Publisher"].nunique())

# Вопрос 5: Больше всего уникальных значений у Publisher (576).

# ==========================================
# Задание 6
# ==========================================
print("\n--- Задание 6 ---")
genre_count = df_clean.groupby("Genre")["Name"].count().sort_values(ascending=False)
print("Количество игр по жанрам:")
print(genre_count)

# ==========================================
# Задание 7
# ==========================================
print("\n--- Задание 7 ---")
genre_sales = df_clean.groupby("Genre")["Global_Sales"].sum().sort_values(ascending=False)
print("Мировые продажи по жанрам (млн):")
print(genre_sales)

# ==========================================
# Задание 8
# ==========================================
print("\n--- Задание 8 ---")
show_cols = ["Rank", "Name", "Platform", "Genre", "Global_Sales"]
print("ТОП-10 самых продаваемых игр:")
print(df_clean.sort_values(by="Global_Sales", ascending=False)[show_cols].head(10))

# ==========================================
# Задание 9
# ==========================================
print("\n--- Задание 9 ---")
print("ТОП-10 платформ по количеству игр:")
print(df_clean.groupby("Platform")["Name"].count().sort_values(ascending=False).head(10))
print("\nТОП-10 платформ по продажам:")
print(df_clean.groupby("Platform")["Global_Sales"].sum().sort_values(ascending=False).head(10))

# ==========================================
# Задание 10
# ==========================================
print("\n--- Задание 10 ---")
plt.figure(figsize=(9, 4.5))
genre_sales.sort_values(ascending=True).plot(kind="barh", color="#2b5c8f")
plt.title("Продажи по жанрам (млн)")
plt.xlabel("Продажи, млн")
plt.ylabel("Жанр")
plt.tight_layout()
plt.show()

# Ответы Задания 10:
# 1. Наибольшие продажи: Action (~1726 млн), Sports (~1309 млн).
# 2. Наименьшие продажи: Strategy (~173 млн), Puzzle (~242 млн).
# 3. Значения отличаются почти в 10 раз.

# ==========================================
# Задание 11
# ==========================================
print("\n--- Задание 11 ---")
corr_na_global = df_clean[["NA_Sales", "Global_Sales"]].corr().iloc[0, 1]
print(f"Коэффициент корреляции NA_Sales и Global_Sales: {corr_na_global:.4f}")

# Ответы Задания 11:
# - Значение положительное (0.9412).
# - Значение очень близко к 1.
# - Да, наблюдается сильная выраженная положительная связь.

# ==========================================
# Задание 12
# ==========================================
print("\n--- Задание 12 ---")
plt.figure(figsize=(8, 5))
plt.scatter(df_clean["NA_Sales"], df_clean["Global_Sales"], alpha=0.5, color="#2b5c8f")
plt.title("Связь продаж в Северной Америке и мировых продаж")
plt.xlabel("Продажи в Северной Америке, млн")
plt.ylabel("Мировые продажи, млн")
plt.tight_layout()
plt.show()

# Ответы Задания 12:
# 1. Одна точка обозначает одну видеоигру.
# 2. Наблюдается четкая восходящая тенденция.
# 3. График полностью соответствует коэффициенту корреляции.

# ==========================================
# Задание 13
# ==========================================
print("\n--- Задание 13 ---")
regions = ["NA_Sales", "EU_Sales", "JP_Sales", "Other_Sales", "Global_Sales"]
corr_matrix = df_clean[regions].corr()
print("Корреляционная таблица регионов:")
print(corr_matrix.round(3))

# Вывод Задания 13:
# Сильнее всего связаны продажи в Северной Америке (NA_Sales) и Европе (EU_Sales) (r = 0.768).
# Японский рынок (JP_Sales) имеет более слабую корреляцию с остальными регионами (r = 0.44–0.45).
